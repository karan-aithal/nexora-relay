<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OPT tests run the real EMV kernel against the same virtual card profiles the
         Phase 2 tests use. Test PANs only (CLAUDE.md section 7.1). -->
    <None Include="../testdata/cards/*.json" Link="cards/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../testdata/keys/bdk.hex" Link="keys/bdk.hex" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenForecourt.SiteController/OpenForecourt.SiteController.csproj" />
    <ProjectReference Include="../../src/OpenForecourt.Adapters.InProc/OpenForecourt.Adapters.InProc.csproj" />
    <ProjectReference Include="../../src/OpenForecourt.Adapters.Sqlite/OpenForecourt.Adapters.Sqlite.csproj" />
  </ItemGroup>

</Project>
